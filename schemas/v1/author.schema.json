{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systems-phd-explorer.local/schemas/v1/author.schema.json",
  "title": "Resolved author identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "author_id",
    "display_name",
    "name_variants",
    "orcid",
    "dblp_url",
    "sources",
    "workflow",
    "verification"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "author_id": {
      "type": "string",
      "pattern": "^author-[a-z0-9][a-z0-9-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "name_variants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "orcid": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"
    },
    "dblp_url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/source"
      }
    },
    "workflow": {
      "$ref": "common.schema.json#/$defs/workflow"
    },
    "verification": {
      "$ref": "common.schema.json#/$defs/verification"
    }
  }
}
