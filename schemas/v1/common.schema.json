{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systems-phd-explorer.local/schemas/v1/common.schema.json",
  "title": "Systems PhD Explorer common definitions",
  "$defs": {
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owner", "updated_at", "notes"],
      "properties": {
        "status": {
          "enum": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "READY_FOR_REVIEW",
            "CHANGES_REQUESTED",
            "APPROVED",
            "BLOCKED"
          ]
        },
        "owner": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "updated_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "kind",
        "title",
        "publisher",
        "retrieved_at",
        "content_hash",
        "official",
        "supports"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^src-[a-z0-9][a-z0-9-]*$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "kind": {
          "enum": [
            "conference-program",
            "conference-proceedings",
            "publisher-page",
            "paper-page",
            "paper-pdf",
            "artifact-page",
            "project-page",
            "institution-page",
            "faculty-page",
            "lab-page",
            "student-page",
            "award-page",
            "dblp",
            "crossref",
            "openalex",
            "semantic-scholar",
            "other"
          ]
        },
        "title": {
          "type": ["string", "null"]
        },
        "publisher": {
          "type": ["string", "null"]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "official": {
          "type": "boolean"
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collected_at",
        "last_verified_at",
        "collector_version",
        "confidence",
        "verified_by",
        "unresolved_fields"
      ],
      "properties": {
        "collected_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "last_verified_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "collector_version": {
          "type": ["string", "null"]
        },
        "confidence": {
          "enum": ["VERIFIED", "HIGH", "MEDIUM", "LOW", "UNRESOLVED"]
        },
        "verified_by": {
          "type": ["string", "null"]
        },
        "unresolved_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "source_ids", "locator"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^claim-[a-z0-9][a-z0-9-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^src-[a-z0-9][a-z0-9-]*$"
          }
        },
        "locator": {
          "type": ["string", "null"]
        }
      }
    },
    "affiliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "institution_id",
        "name_as_published",
        "normalized_name",
        "institution_type",
        "city",
        "state_or_province",
        "country",
        "region",
        "source_ids"
      ],
      "properties": {
        "institution_id": {
          "type": ["string", "null"]
        },
        "name_as_published": {
          "type": "string",
          "minLength": 1
        },
        "normalized_name": {
          "type": ["string", "null"]
        },
        "institution_type": {
          "enum": [
            "university",
            "industrial-research-lab",
            "government-lab",
            "nonprofit",
            "independent",
            "unknown"
          ]
        },
        "city": {
          "type": ["string", "null"]
        },
        "state_or_province": {
          "type": ["string", "null"]
        },
        "country": {
          "type": ["string", "null"]
        },
        "region": {
          "type": ["string", "null"]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^src-[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
