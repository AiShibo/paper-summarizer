{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systems-phd-explorer.local/schemas/v1/faculty.schema.json",
  "title": "Current faculty entity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "faculty_id",
    "author_id",
    "display_name",
    "official_profile_url",
    "current_institution_id",
    "department",
    "faculty_rank",
    "current_location",
    "research_topics",
    "recruiting",
    "sources",
    "workflow",
    "verification"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "faculty_id": {
      "type": "string",
      "pattern": "^faculty-[a-z0-9][a-z0-9-]*$"
    },
    "author_id": {
      "type": "string",
      "pattern": "^author-[a-z0-9][a-z0-9-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "official_profile_url": {
      "type": "string",
      "format": "uri"
    },
    "current_institution_id": {
      "type": "string",
      "pattern": "^institution-[a-z0-9][a-z0-9-]*$"
    },
    "department": {
      "type": ["string", "null"]
    },
    "faculty_rank": {
      "type": ["string", "null"]
    },
    "current_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "state_or_province", "country", "region"],
      "properties": {
        "city": {
          "type": ["string", "null"]
        },
        "state_or_province": {
          "type": ["string", "null"]
        },
        "country": {
          "type": ["string", "null"]
        },
        "region": {
          "type": ["string", "null"]
        }
      }
    },
    "research_topics": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "recruiting": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["exact_statement", "source_id", "last_verified_at"],
      "properties": {
        "exact_statement": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string"
        },
        "last_verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/source"
      }
    },
    "workflow": {
      "$ref": "common.schema.json#/$defs/workflow"
    },
    "verification": {
      "$ref": "common.schema.json#/$defs/verification"
    }
  }
}
